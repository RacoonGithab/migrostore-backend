// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Roles {
  USER
  ADMIN
}

enum VerificationCodeType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
  SECOND_FACTOR_LOGIN
}

model User {
  id         String    @id @default(uuid())
  email      String    @unique
  password   String
  isVerified Boolean   @default(false) @map("is_verified")
  role       Roles     @default(USER)
  isBlocked  Boolean   @default(false) @map("is_blocked")
  blockedAt  DateTime? @map("blocked_at")
  createdAt  DateTime  @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  VerificationCode VerificationCode[] @relation("UserVerificationCode")
  Session          Session[]          @relation("UserSession")
  Resume           Resume[]           @relation("UserResume")

  @@map("users")
}

model VerificationCode {
  id               String               @id @default(uuid())
  userId           String               @map("user_id")
  verificationCode String               @map("verification_code")
  type             VerificationCodeType @map("type")
  isActive         Boolean              @default(true) @map("is_active")
  expiredAt        DateTime             @map("expired_at")
  createdAt        DateTime             @map("created_at")
  updatedAt        DateTime             @updatedAt @map("updated_at")

  User User @relation("UserVerificationCode", fields: [userId], references: [id], onDelete: Cascade)

  @@map("verification_codes")
}

model Session {
  id           String   @id @default(uuid())
  userId       String   @map("user_id")
  refreshToken String   @unique
  accessToken  String   @unique
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  user User @relation("UserSession", fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model Resume {
  id             String   @id @default(uuid())
  firstName      String   @map("first_name")
  lastName       String   @map("last_name")
  age            Int
  education      String
  workExperience String   @map("work_experience")
  aboutMe        String   @map("about_me")
  city           String?
  skills         String[]
  photo          String?
  createdAt      DateTime @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  userId String
  user   User   @relation("UserResume", fields: [userId], references: [id], onDelete: Cascade)

  @@map("resumes")
}

model City {
  id   String @id @default(uuid())
  name String @unique

  @@map("cities")
}

model Skill {
  id   String @id @default(uuid())
  name String @unique

  @@map("skills")
}
