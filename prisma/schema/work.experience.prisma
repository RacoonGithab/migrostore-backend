model WorkExperience {
  id            String    @id @default(uuid())
  position      String
  companyName   String    @map("company_name")
  startDate     DateTime  @map("start_date")
  endDate       DateTime? @map("end_date")
  isCurrentWork Boolean   @default(false) @map("is_current_work")

  resumeId String
  resume   Resume @relation("WorkExperience", fields: [resumeId], references: [id], onDelete: Cascade)

  @@map("work_experiences")
}
