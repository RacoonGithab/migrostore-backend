model Education {
  id              String    @id @default(uuid())
  specialty       String
  institutionName String    @map("institution_name")
  startDate       DateTime  @map("start_date")
  endDate         DateTime? @map("end_date")
  isCurrentStudy  Boolean   @default(false) @map("is_current_study")

  resumeId String
  resume   Resume @relation("Education", fields: [resumeId], references: [id], onDelete: Cascade)

  @@map("educations")
}
