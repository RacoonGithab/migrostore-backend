model User {
  id         String    @id @default(uuid())
  email      String    @unique
  password   String
  isVerified Boolean   @default(false) @map("is_verified")
  role       Roles     @default(USER)
  isBlocked  Boolean   @default(false) @map("is_blocked")
  blockedAt  DateTime? @map("blocked_at")
  createdAt  DateTime  @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  VerificationCode     VerificationCode[]    @relation("UserVerificationCode")
  Session              Session[]             @relation("UserSession")
  Resume               Resume[]              @relation("UserResume")
  UserProfile          UserProfile?          @relation("UserProfile")
  LegalizationRequests LegalizationRequest[] @relation("LegalizationRequests")

  @@map("users")
}
